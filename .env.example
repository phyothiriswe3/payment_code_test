# Copy to .env (gitignored) and fill in. Never commit the real secret.
TWOC2P_MERCHANT_ID=JT01
TWOC2P_SECRET_KEY=<copy from 2C2P Sandbox docs page>
# Public HTTPS URL that forwards to the api on :8080 (cloudflared/ngrok). No trailing slash.
PUBLIC_API_URL=https://<your-tunnel>.trycloudflare.com
FRONTEND_BASE_URL=http://localhost:3000
